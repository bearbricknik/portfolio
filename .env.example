NEXT_PUBLIC_SITE_URL=

# Sanity (public: project and dataset are not secrets)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Sanity webhook (/api/revalidate): the same secret as in the webhook in sanity.io/manage
SANITY_REVALIDATE_SECRET=

# GitHub contribution calendar: one GITHUB_TOKEN_<NAME> + GITHUB_USERNAME_<NAME> pair per
# account (added up per day). Fine-grained tokens, public repositories only, no permissions.
GITHUB_TOKEN_BEARBRICKNICK=
GITHUB_USERNAME_BEARBRICKNICK=

GITHUB_TOKEN_DEIN_BETRIEBSRAT=
GITHUB_USERNAME_DEIN_BETRIEBSRAT=